# Never commit a populated .env file. This key is used only by Hardhat deploy scripts.
PRIVATE_KEY=
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz

# Exposed to the browser intentionally: contract addresses are public.
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_PROBE_CONTRACT_ADDRESS=
NEXT_PUBLIC_REGISTRY_CONTRACT_ADDRESS=
NEXT_PUBLIC_VAULT_CONTRACT_ADDRESS=

# AI providers (server-side only: never add NEXT_PUBLIC_ to these).
# Leave a key empty to hide that provider in the app.
KIMI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional model overrides (defaults shown).
# KIMI_MODEL=kimi-k2.6
# OPENAI_MODEL=gpt-5-mini
# ANTHROPIC_MODEL=claude-haiku-5-5
