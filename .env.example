# Never commit a populated .env file. This key is used only by Hardhat deploy scripts.
PRIVATE_KEY=
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz

# Exposed to the browser intentionally: contract addresses are public.
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_PROBE_CONTRACT_ADDRESS=
NEXT_PUBLIC_REGISTRY_CONTRACT_ADDRESS=
NEXT_PUBLIC_VAULT_CONTRACT_ADDRESS=

# AI providers (server-side only: never add NEXT_PUBLIC_ to these).
# Leave a key empty to hide that provider in the app.
KIMI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional model overrides (defaults shown).
# KIMI_MODEL=kimi-k2.6
# OPENAI_MODEL=gpt-5-mini
# ANTHROPIC_MODEL=claude-haiku-5-5

# AI route abuse control (requests per minute per caller, default 20).
# INTENT_RATE_LIMIT_PER_MINUTE=20

# Automated end-to-end test wallets (testnet-only; created by `npm run e2e:setup`).
E2E_AGENT_PRIVATE_KEY=
E2E_SHOP_PRIVATE_KEY=

# Public "Break the Agent" demo (server only, never NEXT_PUBLIC_). Created by: npm run demo:setup
DEMO_AGENT_PRIVATE_KEY=
DEMO_AGENT_ID=
DEMO_ADDRESS_BOOK=Shop:0x...,Store:0x...
# Optional shared scoreboard (Upstash Redis REST). Without it, counts reset on restart.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Abuse limits for /api/arena
ARENA_RATE_LIMIT_PER_MINUTE=5
ARENA_DAILY_ATTEMPTS=300
