{
  "name": "agentshield",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "contracts:compile": "hardhat compile",
    "contracts:test": "hardhat test",
    "contracts:node": "hardhat node",
    "contracts:deploy:local": "hardhat run scripts/deploy-probe.ts --network localhost",
    "contracts:deploy:testnet": "hardhat run scripts/deploy-probe.ts --network monadTestnet",
    "contracts:deploy:guarded:local": "hardhat run scripts/deploy-guarded.ts --network localhost",
    "contracts:deploy:guarded:testnet": "hardhat run scripts/deploy-guarded.ts --network monadTestnet",
    "contracts:withdraw:testnet": "hardhat run scripts/withdraw-vault.ts --network monadTestnet",
    "e2e": "node --import tsx scripts/e2e.ts",
    "e2e:setup": "node --import tsx scripts/e2e-setup.ts",
    "demo:setup": "node --import tsx scripts/setup-demo-agent.ts",
    "mandates:setup": "hardhat build && node --import tsx scripts/setup-mandates.ts",
    "mcp": "node mcp/server.mjs",
    "mcp:smoke": "node scripts/mcp-smoke.mjs"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "@tanstack/react-query": "^5.104.1",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "^2.57.4",
    "wagmi": "^3.7.7"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "chai": "^6.3.0",
    "dotenv": "^18.0.6",
    "eslint": "^9",
    "typescript-eslint": "^8.71.1",
    "hardhat": "^3.19.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
